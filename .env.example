# ─────────────────────────────────────────────────────────────
# CivicResolve – Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to source control.
# ─────────────────────────────────────────────────────────────

# ── Gemini ────────────────────────────────────────────────────
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# ── Firebase Admin SDK ────────────────────────────────────────
# Get from Firebase Console > Project Settings > Service accounts > Generate new private key
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
FIREBASE_STORAGE_BUCKET=

# ── Firebase Client SDK (public, safe to expose in browser) ───
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# ── Google Maps ───────────────────────────────────────────────
GOOGLE_MAPS_API_KEY=

# ── Cloud Tasks ───────────────────────────────────────────────
# Cloud Tasks queue for background triage/notification jobs
CLOUD_TASKS_QUEUE=
CLOUD_TASKS_LOCATION=
CLOUD_TASKS_SERVICE_URL=

# ── Session ───────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# ── Admin seed ────────────────────────────────────────────────
# Used by scripts/seed-admin.js to create the first admin user
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=

# ── App ───────────────────────────────────────────────────────
PORT=8080
NODE_ENV=development
FIREBASE_EMULATOR=false
DATA_FILE=./data/issues.json
