rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Reports ──────────────────────────────────────────────
    // Citizens can create and read their own reports.
    // Staff (officer/admin) can read and update all reports.
    match /reports/{reportId} {
      allow read: if request.auth != null &&
        (resource.data.uid == request.auth.uid ||
         request.auth.token.role in ['officer', 'admin']);
      allow create: if request.auth != null &&
        request.auth.token.role == 'citizen' &&
        request.resource.data.uid == request.auth.uid;
      allow update: if request.auth != null &&
        request.auth.token.role in ['officer', 'admin'];
    }

    // ── Audit Logs ───────────────────────────────────────────
    // Staff can read; no client writes (server-only via Admin SDK).
    match /auditLogs/{logId} {
      allow read: if request.auth != null &&
        request.auth.token.role in ['officer', 'admin'];
      allow write: if false;
    }

    // ── Users ────────────────────────────────────────────────
    // Users can read/write their own profile.
    // Staff can read any profile.
    // Admins can read and write any profile.
    match /users/{userId} {
      allow read, write: if request.auth != null &&
        request.auth.uid == userId;
      allow read: if request.auth != null &&
        request.auth.token.role in ['officer', 'admin'];
      allow read, write: if request.auth != null &&
        request.auth.token.role == 'admin';
    }

    // ── Translation Cache ────────────────────────────────────
    // Public read (served by server with field filtering).
    // No client writes — cache is populated server-side only.
    match /translationsCache/{cacheId} {
      allow read: if true;
      allow write: if false;
    }

    // ── Config ───────────────────────────────────────────────
    // Staff can read config; only admins can write.
    match /config/{configId} {
      allow read: if request.auth != null &&
        request.auth.token.role in ['officer', 'admin'];
      allow write: if request.auth != null &&
        request.auth.token.role == 'admin';
    }

    // ── Notifications ────────────────────────────────────────
    // Users receive their own notifications only; no client writes.
    match /notifications/{notifId} {
      allow read: if request.auth != null &&
        resource.data.uid == request.auth.uid;
      allow write: if false;
    }
  }
}
