{
  "name": "civicresolve",
  "version": "2.0.0",
  "description": "AI-powered civic grievance reporting, triage and resolution tracking, built on Google Gemini and Cloud Run",
  "main": "server.js",
  "engines": {
    "node": ">=22"
  },
  "license": "MIT",
  "scripts": {
    "start": "node server.js",
    "dev": "cross-env FIREBASE_EMULATOR=true node server.js",
    "test": "cross-env NODE_ENV=test node --test \"test/**/*.test.js\"",
    "test:unit": "cross-env NODE_ENV=test node --test \"test/unit/*.test.js\"",
    "test:integration": "cross-env NODE_ENV=test node --test \"test/integration/*.test.js\"",
    "lint": "eslint .",
    "seed:admin": "node scripts/seed-admin.js",
    "seed:data": "node scripts/seed-data.js",
    "i18n:generate": "node scripts/i18n-generate.js"
  },
  "dependencies": {
    "@google-cloud/storage": "^7.14.0",
    "@google-cloud/tasks": "^5.5.0",
    "compression": "^1.7.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "express-session": "^1.18.1",
    "firebase-admin": "^13.0.2",
    "helmet": "^8.0.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "cross-env": "^7.0.3",
    "eslint": "^10.15.0"
  }
}
